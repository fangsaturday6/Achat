# Achat 云端服务的设置，install.sh 会复制到 /etc/achat/achat.env（只有 root 能读）。

# 大家访问 Achat 的地址，邀请链接和添加电脑的链接都用它。
ACHAT_PUBLIC_URL=https://achat.example.com

# Resend 的 API Key 和发件人。发件人的域名要先在 Resend 里验证。
# 不填的话，验证码只打印在服务日志里（journalctl -u achat），不会发邮件。
RESEND_API_KEY=
ACHAT_MAIL_FROM=Achat <login@example.com>

# 数据库文件。
ACHAT_DB=/var/lib/achat/achat.db

# 只在本机监听，由 Caddy 转发 HTTPS 请求过来。
HOST=127.0.0.1
PORT=8080
ACHAT_TRUST_PROXY=1
